# Copy to .env and fill in. Everything works without a key (offline policy + TF-IDF).
GEMINI_API_KEY=
PW_LLM=gemini              # gemini | offline
PW_GEMINI_MODEL=gemini-2.5-flash
PW_EMBEDDER=tfidf          # tfidf | gemini
PW_DATA_MODE=synthetic     # synthetic | openfda
OPENFDA_API_KEY=           # optional, raises openFDA rate limits
# DATABASE_URL=postgresql+psycopg2://pw:pw@localhost:5432/pharmawatch   (default: SQLite in artifacts/)
